# Copia este fichero como .env y cambia los valores. Docker Compose lo lee al arrancar.

# Clave de firma de los JWT: al menos 32 bytes.
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-bytes

# Administrador inicial: solo se crea si la tabla usuario está vacía.
# La contraseña debe tener entre 8 y 72 caracteres.
ADMIN_EMAIL=admin@facturacion.local
ADMIN_PASSWORD=cambia-esta-password
